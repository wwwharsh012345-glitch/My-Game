# Global .gitignore for Android projects.
# This file specifies intentionally untracked files that Git should ignore.
# It helps keep the repository clean and avoids committing machine-specific,
# build-generated, or sensitive files.

# Gradle files and directories generated during the build process.
# These files are typically temporary, machine-specific, or derived, and
# should not be committed to version control.
.gradle/
build/

# Local configuration file (sdk path, etc)
# Contains local machine-specific settings like the Android SDK path.
# This file should never be committed as it varies across developer environments.
local.properties

# Log files generated by the application or build tools.
# These files contain transient information and can be large, making them
# unsuitable for version control.
*.log

# Android Studio generated files and folders.
# These are IDE-specific or build-generated artifacts that are not part of
# the source code and can be regenerated.
captures/ # Performance profiler capture files.
.externalNativeBuild/ # Directory for intermediate native (C/C++) build files.
.cxx/ # NDK/CMake build artifacts for native libraries.
*.aab # Android App Bundle files, the final build output for publishing.
*.apk # Android Package Kit files, the installable application files.
output-metadata.json # Metadata generated alongside build outputs like APKs/AABs.

# IntelliJ IDEA (and Android Studio) generated files and directories.
# These contain IDE-specific settings, workspace information, and user preferences.
# Committing them can lead to conflicts and expose local configurations.
*.iml # IntelliJ module files.
.idea/ # Directory containing project-level IntelliJ IDEA settings and workspace files.
misc.xml # Various project settings, often user-specific.
deploymentTargetDropDown.xml # Stores deployment target configurations in the IDE.
render.experimental.xml # Settings related to experimental rendering features in the IDE.

# Keystore files used for signing applications.
# These files contain sensitive private keys and credentials.
# They MUST NOT be committed to version control for security reasons.
*.jks # Java KeyStore files.
*.keystore # Generic keystore files.

# Google Services configuration file.
# This file contains API keys and configuration for Google services (e.g., Firebase).
# While sometimes committed, it often contains environment-specific settings or
# API keys that should be managed separately (e.g., via CI/CD or template).
google-services.json

# Android Profiling heap dump files.
# These are large, temporary files generated during memory profiling sessions
# and contain memory snapshots.
*.hprof